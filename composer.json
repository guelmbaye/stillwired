{
  "name": "stillwired/gate1",
  "description": "STILLWIRED synthetic residual-flow proof — Symfony AI/MCP integration candidate",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "nyholm/psr7": "^1.8",
    "symfony/ai-agent": "^1.0",
    "symfony/ai-bundle": "^1.0",
    "symfony/ai-mcp-tool": "^1.0",
    "symfony/ai-open-ai-platform": "^1.0",
    "symfony/console": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/http-client": "^7.4",
    "symfony/mcp-bundle": "^1.0",
    "symfony/webhook": "^8.1",
    "symfony/yaml": "^7.4"
  },
  "autoload": {"psr-4": {"Stillwired\\": "src/"}},
  "config": {"allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true
    }, "sort-packages": true},
  "minimum-stability": "dev",
  "prefer-stable": true
}
